{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev:backend": {
      "cache": false,
      "persistent": true,
      "command": "uv run --project apps/backend uvicorn app.main:app --reload --port 8000"
    },
    "migrate": {
      "cache": false,
      "command": "uv run --project apps/backend alembic upgrade head"
    },
    "gen:api": {
      "cache": false,
      "outputs": ["apps/web/lib/api/api.d.ts", "apps/backend/openapi.json"]
    }
  }
}
