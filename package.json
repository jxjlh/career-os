{
  "name": "ai-aggregation-app",
  "version": "0.1.0",
  "private": true,
  "description": "AI Aggregation App - Monorepo with Next.js 15 + FastAPI",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "pnpm --filter @ai-aggregation/web run dev",
    "dev:backend": "uv run --project apps/backend uvicorn app.main:app --reload --port 8000",
    "gen:api": "pnpm run gen:openapi && pnpm run gen:types",
    "gen:openapi": "uv run --project apps/backend python -m app.main --export-openapi",
    "gen:types": "openapi-typescript apps/backend/openapi.json -o apps/web/lib/api/api.d.ts",
    "migrate": "uv run --project apps/backend alembic upgrade head",
    "migrate:create": "uv run --project apps/backend alembic revision --autogenerate",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.0"
  }
}
