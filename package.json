{
  "name": "career-os",
  "version": "0.1.0",
  "private": true,
  "description": "Career OS - AI Career Growth Platform",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "uv run --project apps/api uvicorn app.main:app --reload --port 8000",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/web run test && uv run --project apps/api pytest"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  }
}
