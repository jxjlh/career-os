#!/usr/bin/expect -f
set timeout 600
set PASS "LH040828@"
set SERVER "ubuntu@124.223.183.102"
set REMOTE "/opt/ai-life-os"

puts "===== Step 1: SCP 03-setup-ssl.sh 到服务器 =====\n"
spawn scp -o StrictHostKeyChecking=no /Users/liheng/Documents/AI职业发展路径规划/deploy/03-setup-ssl.sh $SERVER:$REMOTE/
expect {
    "password:" { send "$PASS\r"; exp_continue }
    "100%" { }
    timeout { puts "TIMEOUT scp"; exit 1 }
}
expect eof

puts "\n===== Step 2: SSH 执行 SSL 配置脚本 =====\n"
spawn -noecho ssh -o StrictHostKeyChecking=no -t $SERVER "cd $REMOTE && chmod +x 03-setup-ssl.sh && bash 03-setup-ssl.sh 2>&1; echo SCRIPT_EXIT_\$?"

expect {
    "password:" { send "$PASS\r"; exp_continue }
    -re "SCRIPT_EXIT_(\\d+)" {
        set rc $expect_out(1,string)
        puts "\n\n===== Script exit: $rc ====="
    }
    timeout { puts "TIMEOUT" }
    eof { }
}
expect eof
