#!/usr/bin/expect -f
set timeout 60
set PASS "LH040828@"
set SERVER "ubuntu@124.223.183.102"

spawn -noecho ssh -o StrictHostKeyChecking=no $SERVER "docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'; echo ---; ls /opt/ai-life-os/build/app/core/middleware.py; head -5 /opt/ai-life-os/build/app/core/middleware.py"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    timeout { puts "TIMEOUT" }
    eof { }
}
expect eof
