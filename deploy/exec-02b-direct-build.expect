#!/usr/bin/expect -f
set timeout 1800
set PASS "LH040828@"
set SERVER "ubuntu@124.223.183.102"
set REMOTE "/opt/ai-life-os"

puts "===== 直接构建：不通过 tail 管道，实时输出 =====\n"

spawn -noecho ssh -o StrictHostKeyChecking=no -t $SERVER "cd $REMOTE && sg docker -c 'docker compose build --no-cache api' 2>&1; echo BUILD_RC=\$?"

expect {
    "password:" { send "$PASS\r"; exp_continue }
    -re "BUILD_RC=(\\d+)" {
        set rc $expect_out(1,string)
        puts "\n\n===== Build RC: $rc ====="
        if {$rc != 0} {
            puts "BUILD FAILED"
        } else {
            puts "BUILD SUCCESS"
        }
    }
    timeout { puts "TIMEOUT" }
    eof { }
    "ERROR" { puts "ERROR in build" }
}
expect eof
