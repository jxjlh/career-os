# ============================================================
# AI Life OS 后端环境变量样例
# 部署到 Render / Fly.io / Koyeb 时按此填写（不含真实值提交到仓库）。
# 本地开发：复制为 apps/api/.env 后填入实际值。
# ============================================================

# 应用环境 (dev / test / production)
APP_ENV=production

# API 路径前缀
API_PREFIX=/api/v1

# ---------- 数据库 (Supabase Postgres) ----------
# 用 Pooler 连接串（pgbouncer 模式），格式：
# postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@host:port/dbname?pgbouncer=true

# ---------- CORS ----------
# 逗号分隔的允许来源。前端走 rewrite 代理时浏览器不直连后端，但显式配置更安全。
# 生产填 Vercel 域名；本地开发默认 http://localhost:3000
CORS_ORIGINS=https://your-vercel-app.vercel.app

# ---------- Supabase 认证 ----------
# 二选一：用 JWT secret（HS256，推荐）或 JWKS URL（ES256）
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---------- Supabase 基础配置 ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 私有图片/视频 bucket；首次上传会自动创建（默认 life-records）。
SUPABASE_STORAGE_BUCKET=life-records

# ---------- 讯飞星火 AI ----------
XFYUN_API_KEY=your-xfyun-api-key
XFYUN_API_SECRET=your-xfyun-api-secret
XFYUN_APP_ID=your-xfyun-app-id
SPARK_MODEL=Spark-Lite
SPARK_WS_URL=wss://spark-api.xf-yun.com/v1.1/chat
SPARK_DOMAIN=lite

# ---------- 联网搜索（可选，按需开启） ----------
# TAVILY_API_KEY=
# EXA_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# BING_API_KEY=
# GITHUB_TOKEN=
# YOUTUBE_API_KEY=

# ---------- 个人理财（仅对接已授权的数据/OCR 服务） ----------
# 行情服务须实现 GET {FINANCE_MARKET_DATA_BASE_URL}/quotes，接受重复 market/symbol 参数。
# 未配置时保留手动记账，但分析接口只返回 unavailable/stale 状态且不生成操作卡片。
FINANCE_MARKET_DATA_BASE_URL=
FINANCE_MARKET_DATA_API_KEY=
FINANCE_OCR_API_URL=
FINANCE_OCR_API_KEY=
# 未配置独立 OCR 服务时，若 OPENAI_API_KEY 可用，系统会使用 OpenAI-compatible 视觉模型。
# 模型需支持图片输入与 JSON 输出；默认 gpt-4o-mini。
FINANCE_OCR_MODEL=gpt-4o-mini
# GitHub Actions 每日任务和 Render 必须配置为同一随机值（使用不少于 32 字节的随机值）。
# 同时在 GitHub Actions 配置 FINANCE_SCHEDULER_TOKEN 与 FINANCE_ANALYSIS_API_URL 两个 secrets。
# 未配置时，匿名调度请求会返回 401；普通登录用户仍可仅运行自己的分析。
FINANCE_SCHEDULER_TOKEN=
