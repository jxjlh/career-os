# ══════════════════════════════════════════════════════════════
# AI Aggregation App — Environment Variables
# Copy to .env and fill in your keys
# ══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_ENV=dev
APP_NAME=ai-aggregation-app
DEBUG=true

# ─── Database (PostgreSQL with pgvector) ──────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agg_db

# ─── Redis (for ARQ async queue + caching) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Providers ─────────────────────────────────────────────
# iFlytek Spark (讯飞星火) — primary
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_APP_ID=
SPARK_MODEL=Spark-X2-Flash
SPARK_WS_URL=wss://spark-api.xf-yun.com/v3.5/chat
SPARK_DOMAIN=generalv3.5

# OpenAI — fallback / compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Search Providers ─────────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=
BING_API_KEY=
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_UPSTREAM=http://127.0.0.1:8000

# ─── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
